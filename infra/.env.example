# Copy to .env (same directory) and fill in. Never commit the real .env.

# dev | prod  — prod hides /docs.
ENV=prod

# Browsers allowed to call the API (CORS + CSRF origin allowlist).
# Production: the site origin. Dev: add http://localhost:5173
ALLOWED_ORIGINS=https://nortadesyco.xyz

# Resend transactional email for the consultation form. Blank = disabled.
RESEND_API_KEY=
CONSULTATION_NOTIFY_TO=alex.norta@nortadesyco.xyz
EMAIL_FROM=Norta DeSyCo Website <onboarding@resend.dev>
